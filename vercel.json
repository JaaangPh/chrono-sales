{
  "version": 2,
  "functions": {
    "*.php": {
      "runtime": "vercel-php@0.7.3"
    },
    "public/*.php": {
      "runtime": "vercel-php@0.7.3"
    },
    "backend/*.php": {
      "runtime": "vercel-php@0.7.3"
    }
  },
  "routes": [
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/backend/(.*)",
      "dest": "/backend/$1"
    },
    {
      "src": "/public/(.*)",
      "dest": "/public/$1"
    },
    {
      "src": "/public",
      "dest": "/public/index.php"
    },
    {
      "src": "/",
      "dest": "/index.php"
    }
  ]
}

